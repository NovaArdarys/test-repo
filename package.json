{
  "name": "backend",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "infra:up": "bun run scripts/infra-up.ts",
    "infra:down": "bun run scripts/infra-down.ts",
    "infra:reset": "docker compose stop redis rabbitmq && docker compose rm -fv redis rabbitmq && docker volume rm backend_redis_data backend_rabbitmq_data && docker compose up -d redis rabbitmq",
    "check:imports": "bun scripts/check-imports.ts",
    "check:used": "bun  scripts/scan-import-prefix.ts",
    "run:all": "bun scripts/start-all-no-ui.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsx": "^4.20.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/blessed": "^0.1.25",
    "@types/pidusage": "^2.0.5",
    "axios": "^1.12.2",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "dotenv": "^17.2.2",
    "picocolors": "^1.1.1",
    "pidusage": "^4.0.1"
  },
  "packageManager": "pnpm@10.4.0+sha512.6b849d0787d97f8f4e1f03a9b8ff8f038e79e153d6f11ae539ae7c435ff9e796df6a862c991502695c7f9e8fac8aeafc1ac5a8dab47e36148d183832d886dd52"
}
